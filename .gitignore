# ── Model weights (too large for git) ───────────────────
pretrained/
*.pt
*.pth
*.onnx
*.safetensors
*.pkl
*.h5
*.hdf5

# ── Bundled data (ships in the folder, never in git) ─────
# The deposited-structure database and the cgRNASP reference data travel with the working folder
# so that a copied directory is self-contained, and are listed here so that no future `git add -A`
# can stage them. This is the rule that exists because 4.9 GB once reached history and took three
# rounds of git filter-repo to remove.
_cgdata/

# ── External predictors (installed separately) ──────────
RNAbpFlow/
external/
rhofold/     # RhoFold+ checkout
msa_work/

# ── Run outputs (generated, large) ──────────────────────
output_*/
benchmark_*/
CIF_PDB_PSM/
_final_*.pdb
_final_out/
*.log

# ── Local config / private sequence ─────────────────────
sequence.txt
test_*_ss.txt
# .claude/ is ignored except the iGEM AI-use notice
.claude/*
!.claude/RESPONSIBLE_AI_USE.md
torusfold-paper/
